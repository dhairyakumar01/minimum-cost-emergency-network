{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__path__=/api/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/frontend/assets/$1"
    },
    {
      "source": "/flutter/(.*)",
      "destination": "/flutter_app/build/web/$1"
    },
    {
      "source": "/app",
      "destination": "/frontend/app/index.html"
    },
    {
      "source": "/app/",
      "destination": "/frontend/app/index.html"
    },
    {
      "source": "/app/(.*)",
      "destination": "/frontend/app/$1"
    },
    {
      "source": "/favicon.ico",
      "destination": "/frontend/favicon.ico"
    },
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ]
}
