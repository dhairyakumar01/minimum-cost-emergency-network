{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__path__=/api/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/api/index.py?__path__=/assets/$1"
    },
    {
      "source": "/app",
      "destination": "/api/index.py?__path__=/app"
    },
    {
      "source": "/app/",
      "destination": "/api/index.py?__path__=/app/"
    },
    {
      "source": "/app/(.*)",
      "destination": "/api/index.py?__path__=/app/$1"
    },
    {
      "source": "/favicon.ico",
      "destination": "/api/index.py?__path__=/favicon.ico"
    },
    {
      "source": "/",
      "destination": "/api/index.py?__path__=/"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.py?__path__=/$1"
    }
  ]
}
